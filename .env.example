# TRADER — application configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
# This is application config; machine/SSH topology lives in machines.example.env.
#
# Anything prefixed NEXT_PUBLIC_ or EXPO_PUBLIC_ is INLINED INTO THE CLIENT BUNDLE
# and is therefore public. Publishable keys only — never a secret.

# --- Database (Neon) ---
# Pooled connection, used by the app at runtime.
DATABASE_URL=
# Direct (unpooled) connection, used ONLY by drizzle-kit for migrations.
# DDL through PgBouncer transaction pooling misbehaves; keep these separate.
DATABASE_URL_UNPOOLED=

# Local development against Docker Postgres instead of Neon. When "true",
# packages/db uses the node-postgres driver; the Neon serverless driver speaks
# HTTP/WebSocket to Neon's proxy and cannot talk to a plain Postgres server.
# `pnpm db:up` starts the container matching this URL.
USE_LOCAL_POSTGRES=true
LOCAL_DATABASE_URL=postgresql://trader:trader@localhost:5432/trader

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk user ID promoted to `admin` by `pnpm db:seed`. Everyone else defaults to
# `worker` on first authenticated request.
SEED_ADMIN_CLERK_USER_ID=

# --- Mobile ---
# Origin of the deployed web app, which also hosts the tRPC API.
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Observability (Sentry) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# Source-map upload. CI only — never committed, never in a client bundle.
SENTRY_AUTH_TOKEN=
