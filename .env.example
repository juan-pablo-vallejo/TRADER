# TRADER — environment contract. Copy to .env and fill in; .env is gitignored and stays so.
# NEXT_PUBLIC_ and EXPO_PUBLIC_ prefixes are inlined into client bundles: public, literally.

# Local Postgres, read by docker-compose.yml through `pnpm db:up`.
# Pick any password; it never leaves this machine.
POSTGRES_USER=trader
POSTGRES_PASSWORD=
POSTGRES_DB=trader

# Database connection, read by packages/db/src/env.ts (the Drizzle client, drizzle-kit, tests,
# the seed).
# Unset or empty: the three POSTGRES_* variables above reach the compose container on
# 127.0.0.1:5432. Set: used verbatim and the POSTGRES_* variables are not required (Neon).
DATABASE_URL=
# Driver behind the Drizzle client; `pg` is the only value until Neon's first consumer.
DATABASE_DRIVER=pg

# Development identity, read by packages/api/src/dev-identity.ts and apps/web/src/server/identity.ts.
# Blank is off. `enabled` trusts the x-trader-dev-subject and x-trader-dev-email headers, or the
# trader-dev-email cookie set by POST /dev-signin (subject `dev:` + the email lowercased), as a
# verified login, and only under NODE_ENV=development or test; under any other NODE_ENV the API
# refuses the request and /dev-signin answers 404.
TRADER_DEV_IDENTITY=

# Kill switch, read by packages/api/src/status.ts. Server-only, never EXPO_PUBLIC_. Blank is
# normal; `read_only` holds pushes, `paused` holds all sync. Builds below a minimum (a positive
# integer; blank is 1) are told to update. An invalid value answers `paused` and is reported.
# Deployed values change only with a new deployment.
TRADER_SYNC_MODE=
TRADER_MIN_BUILD_IOS=
TRADER_MIN_BUILD_ANDROID=
