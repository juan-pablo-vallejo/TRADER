# TRADER — environment contract. Copy to .env and fill in; .env is gitignored and stays so.
# NEXT_PUBLIC_ and EXPO_PUBLIC_ prefixes are inlined into client bundles: public, literally.

# Local Postgres, read by docker-compose.yml through `pnpm db:up`.
# Pick any password; it never leaves this machine.
POSTGRES_USER=trader
POSTGRES_PASSWORD=
POSTGRES_DB=trader
