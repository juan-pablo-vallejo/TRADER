# TRADER — machine topology template
#
# Copy to `.env.machines` and fill in your own values:
#
#     cp machines.example.env .env.machines
#
# `.env.machines` is gitignored by the `.env.*` rule and must stay that way — it
# describes machines that are not internet-exposed, and this repository is public.
#
# Note the filename: a template named `.env.machines.example` would be silently
# ignored, because the `!.env.example` negation in .gitignore rescues only that
# exact name, not `.env.*.example`.
#
# These values are read by you when connecting, not by the application. Keep
# application config (DATABASE_URL, Clerk keys) in `.env`, which Next.js loads
# into the app runtime.
#
# Every alias below must have a matching `Host` block in your ~/.ssh/config;
# see WORKFLOW.md for what each machine is for.

# --- Linux workstation (Docker, Postgres, long-running jobs) ---
# Alias that auto-selects LAN vs VPN, if your ssh config has such a probe.
WORKSTATION_ALIAS=workstation
# Alias that forces the LAN path. Set equal to WORKSTATION_ALIAS if you have only one.
WORKSTATION_LAN_ALIAS=workstation-local
# Prefer a stable name (mDNS `.local`, or a DHCP reservation) over a bare IP.
WORKSTATION_HOST=your-workstation.local
WORKSTATION_USER=your-user
# Leave blank if you do not reach this machine over a VPN.
WORKSTATION_VPN_HOST=

# --- Windows box (optional; legacy from the prior Flutter project) ---
# If this is the same physical hardware as the workstation on a dual boot, only
# one of the two is reachable at any given time.
WINDOWS_ALIAS=
WINDOWS_HOST=
WINDOWS_USER=

# --- WSL2 on the Windows box (optional) ---
WSL_ALIAS=
WSL_HOST=
WSL_PORT=2222
WSL_USER=
