#!/bin/sh
# Refuses the pushes CLAUDE.md forbids, whoever types them: a push to `production`, a push
# to `main` of a tree no green check was recorded for, a push to `main` while a pull request
# into `production` is open, and any push whose new commits hold a secret (this repository
# is public: a secret pushed is a secret published, and CI's scan comes after).
# The record of greens is one line per tree in .git/trader/green, "<tree> check <when>
# <where>", written when `pnpm check:ci` ends green on that exact tree.
# Enabled once per clone:  git config core.hooksPath .githooks
set -eu
ledger=$(git rev-parse --git-common-dir)/trader/green
top=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000

# A tree that differs from a checked one in Markdown alone needs no second check: of the
# steps of `check`, only the format check reads a .md file, and it is run here on the files
# that changed, as the commit holds them.
markdown_only() { # <commit>
  [ -s "$ledger" ] || return 1
  [ -x "$top/node_modules/.bin/prettier" ] || return 1
  for green in $(awk '$2 == "check" { print $1 }' "$ledger" | tail -n 30 | sort -u); do
    git cat-file -e "$green^{tree}" 2>/dev/null || continue
    changed=$(git diff --name-only "$green" "$1^{tree}") || continue
    if printf '%s\n' "$changed" | grep -qv '\.md$'; then continue; fi
    git diff --name-only --diff-filter=d "$green" "$1^{tree}" | while IFS= read -r file; do
      git show "$1:$file" | (cd "$top" && node_modules/.bin/prettier --stdin-filepath "$file" --check >/dev/null 2>&1) || {
        echo "pre-push: $file is not formatted (pnpm format)" >&2
        exit 1
      }
    done || return 1
    return 0
  done
  return 1
}

while read -r _ local_sha remote_ref remote_sha; do
  if [ "$local_sha" != "$zero" ]; then
    # Only the commits this push adds: none of them is on the remote yet.
    if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes=$1"; else range="$remote_sha..$local_sha"; fi
    if ! command -v gitleaks >/dev/null 2>&1; then
      echo "pre-push: gitleaks is not installed, so nothing is pushed (brew install gitleaks)" >&2
      exit 1
    fi
    if ! gitleaks git --redact --no-banner --verbose --log-level error --exit-code 1 --log-opts="$range" . >&2 </dev/null; then
      echo "pre-push: a commit in this push holds what looks like a secret; nothing is pushed" >&2
      exit 1
    fi
  fi
  case "$remote_ref" in
    refs/heads/production)
      echo "pre-push: production takes releases only, by the owner's merge" >&2
      exit 1
      ;;
    refs/heads/main)
      if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: main is never deleted" >&2
        exit 1
      fi
      tree=$(git rev-parse "$local_sha^{tree}")
      if ! grep -qs "^$tree check " "$ledger" && ! markdown_only "$local_sha" </dev/null; then
        echo "pre-push: no green check is recorded for tree $tree" >&2
        echo "          run the verify skill: it checks this tree and records it" >&2
        exit 1
      fi
      if ! open=$(gh pr list --base production --state open --json number --jq length 2>/dev/null </dev/null); then
        echo "pre-push: GitHub did not say whether a release is open; main is not pushed" >&2
        exit 1
      fi
      if [ "$open" != 0 ]; then
        echo "pre-push: a pull request into production is open; main waits for the release" >&2
        exit 1
      fi
      ;;
  esac
done
