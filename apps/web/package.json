{
  "name": "@trader/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e:staging": "playwright test -c e2e/playwright.config.ts",
    "e2e:local": "playwright test -c e2e/local.config.ts",
    "look": "pnpm --filter @trader/api demo --db trader_demo_look --reset && export LOOK_DIR=\"${LOOK_DIR:-$HOME/Library/Caches/TRADER/look/web-$(date +%Y%m%d-%H%M%S)}\" && playwright test -c e2e/look.local.config.ts && LOOK_PASS=frame playwright test -c e2e/look.local.config.ts"
  },
  "dependencies": {
    "@clerk/localizations": "4.24.6",
    "@clerk/nextjs": "^7.9.25",
    "@sentry/nextjs": "11.12.0",
    "@tanstack/react-query": "^5.106.1",
    "@trader/api": "workspace:*",
    "@trader/db": "workspace:*",
    "@trpc/client": "11.23.0",
    "@trpc/server": "11.23.0",
    "@trpc/tanstack-react-query": "11.23.0",
    "@vercel/functions": "3.11.3",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "superjson": "^2.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-orm": "^0.45.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
