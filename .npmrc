# Metro (React Native) resolves poorly through pnpm's symlinked store. Hoisting
# sidesteps a whole class of "module not found" failures in the mobile app, at the
# cost of pnpm's strict phantom-dependency detection.
#
# Revisit: Expo 57 may not need this. Try removing it and running the mobile app;
# if Metro resolves cleanly, drop the line.
node-linker=hoisted
