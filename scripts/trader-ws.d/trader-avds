#!/usr/bin/env bash
# ~/bin/trader-avds on the workstation's job account: the emulator profiles the layout sweep
# runs on, made once and left alone after. The screen sizes are the plan's matrix: a small
# phone (720x1600 at 320 dpi, 360 points wide), the Moto g04s's shape (720x1612 at 280), and
# the oldest Android the app supports (API 24, its floor), at a common size, and the
# narrowest a phone comes (640x1386 at 320 dpi, 320 points wide). `trader` is the
# phone flows' own (1080x2400 at 420). A system image not yet under /opt is installed by
# the admin account (sdkmanager), never here: this account cannot write /opt.
#   trader-avds
set -euo pipefail
export ANDROID_HOME=/opt/android-sdk ANDROID_AVD_HOME=$HOME/.android/avd
avdmanager=$ANDROID_HOME/cmdline-tools/latest/bin/avdmanager
make() { # name, image, width, height, density
  local name=$1 image=$2
  [[ -d $ANDROID_AVD_HOME/$name.avd ]] && { echo "have $name"; return; }
  [[ -d $ANDROID_HOME/${image//;//} ]] || { echo "no image ${image} under /opt: the admin installs it"; return 1; }
  echo no | "$avdmanager" create avd -n "$name" -k "$image" -d pixel >/dev/null
  printf 'hw.lcd.width=%s\nhw.lcd.height=%s\nhw.lcd.density=%s\nhw.keyboard=no\n' "$3" "$4" "$5" \
    >>"$ANDROID_AVD_HOME/$name.avd/config.ini"
  echo "made $name"
}
make trader-small "system-images;android-36;google_apis;x86_64" 720 1600 320
make trader-medium "system-images;android-36;google_apis;x86_64" 720 1612 280
make trader-oldest "system-images;android-24;google_apis;x86_64" 1080 1920 420
make trader-compact "system-images;android-36;google_apis;x86_64" 640 1386 320
