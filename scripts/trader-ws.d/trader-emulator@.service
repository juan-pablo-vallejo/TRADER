# ~/.config/systemd/user/trader-emulator@.service, on the workstation's job account. One
# Android emulator by its profile's name (the instance: trader, trader-small, trader-medium,
# trader-oldest, trader-compact; made by trader-avds), headless, started when a phone job
# asks for it and stopped when the job ends. Software GPU: the flows need a screen that draws
# the same every run, not a fast one. A full boot every time (-no-snapshot): the device's
# data stays, its RAM image does not. The flags are emulator 37.3.10's (`emulator -help`, read 2026-11-22).
[Unit]
Description=TRADER Android emulator %i (headless)

#
# Each profile has its own console port, so the sweep's lanes run side by side: trader
# 5554, trader-small 5556, trader-medium 5558, trader-oldest 5560, trader-compact 5562; its
# serial is emulator-<port> (trader-android, port()). Four lanes at 12G each leave the
# box's 64G room for the lanes' APIs and Metro. `$$` is a `$` that systemd hands the shell
# untouched.
[Service]
Environment=ANDROID_HOME=/opt/android-sdk
Environment=ANDROID_AVD_HOME=%h/.android/avd
ExecStart=/bin/sh -c 'case %i in trader) p=5554;; trader-small) p=5556;; trader-medium) p=5558;; trader-oldest) p=5560;; trader-compact) p=5562;; *) exit 64;; esac; exec /opt/android-sdk/emulator/emulator -avd %i -port $$p -no-window -no-audio -no-boot-anim -no-snapshot -gpu swiftshader_indirect'
ExecStop=/bin/sh -c 'case %i in trader) p=5554;; trader-small) p=5556;; trader-medium) p=5558;; trader-oldest) p=5560;; trader-compact) p=5562;; esac; /opt/android-sdk/platform-tools/adb -s emulator-$$p emu kill'
TimeoutStartSec=300
MemoryMax=12G
Restart=no
